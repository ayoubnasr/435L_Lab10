pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
        DEPLOY_DIR = 'C:\\jenkins_deployments\\python_app'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}\\${VIRTUAL_ENV}")) {
                        bat "python -m venv ${VIRTUAL_ENV}"
                    }
                    bat "${VIRTUAL_ENV}\\Scripts\\activate.bat && python -m pip install --upgrade pip && pip install -r requirements.txt"
                }
            }
        }

        stage('Lint') {
            steps {
                script {
                    bat "${VIRTUAL_ENV}\\Scripts\\activate.bat && flake8 app.py tests/test_app.py"
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    bat "${VIRTUAL_ENV}\\Scripts\\activate.bat && pytest"
                }
            }
        }

        stage('Coverage') {
            steps {
                script {
                    bat "${VIRTUAL_ENV}\\Scripts\\activate.bat && coverage run -m pytest && coverage report -m"
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    bat "${VIRTUAL_ENV}\\Scripts\\activate.bat && bandit -r app.py"
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo "Deploying application to local directory: ${DEPLOY_DIR}..."
                    bat """
                        if not exist "${DEPLOY_DIR}" mkdir "${DEPLOY_DIR}"
                        copy /Y app.py "${DEPLOY_DIR}\\app.py"
                        copy /Y requirements.txt "${DEPLOY_DIR}\\requirements.txt"
                        ${VIRTUAL_ENV}\\Scripts\\python.exe "${DEPLOY_DIR}\\app.py"
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
